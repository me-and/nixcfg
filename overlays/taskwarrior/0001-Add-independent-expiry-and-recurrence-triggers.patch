diff --git a/test/gc.test.py b/test/gc.test.py
index 2b3c0577e..5ec15b08f 100755
--- a/test/gc.test.py
+++ b/test/gc.test.py
@@ -61,6 +61,105 @@ class TestGC(TestCase):
         code, out, err = self.t("gctest")
         self.assertRegex(out, r"2\s+two\s+TWO", "modified 'two'")
 
+    def test_gc_off_until(self):
+        """Expired tasks are deleted without renumbering when GC is off"""
+        self.t.config("gc", "0")
+        self.t.config("expiry", "1")
+        self.t("1 modify until:2000-01-01")
+        self.t("2 modify until:2100-01-01")
+
+        code, out, err = self.t("list")
+        self.assertNotIn("one", out)
+        tasks = {task["description"]: task for task in self.t.export()}
+        self.assertEqual(tasks["one"]["status"], "deleted")
+        self.assertEqual(tasks["two"]["status"], "pending")
+        self.assertEqual(tasks["two"]["id"], 2)
+        self.assertEqual(tasks["three"]["id"], 3)
+
+        self.t("rc.gc=1 list")
+        tasks = {task["description"]: task for task in self.t.export()}
+        self.assertEqual(tasks["two"]["id"], 1)
+        self.assertEqual(tasks["three"]["id"], 2)
+
+    def test_maintenance_controls(self):
+        """Expiry and recurrence independently override or inherit GC"""
+        for gc in ("0", "1"):
+            for value in (None, "", "on", "off"):
+                with self.subTest(gc=gc, value=value):
+                    t = Task()
+                    t.config("gc", gc)
+                    for option in ("expiry", "recurrence.trigger"):
+                        if value is not None:
+                            t.config(option, value)
+                    t("add expired until:2000-01-01")
+                    t("add recurring due:tomorrow recur:daily")
+                    t("count")
+                    tasks = t.export("rc.gc=0 rc.expiry=0 rc.recurrence.trigger=0")
+                    enabled = gc == "1" if value in (None, "") else value == "on"
+                    expired = next(t for t in tasks if t["description"] == "expired")
+                    self.assertEqual(
+                        expired["status"], "deleted" if enabled else "pending"
+                    )
+                    self.assertEqual(
+                        sum("parent" in task for task in tasks), int(enabled)
+                    )
+
+    def test_maintenance_independence(self):
+        """Expiry and recurrence can run separately without compacting IDs"""
+        for expiry, recurrence in (("1", "0"), ("0", "1")):
+            with self.subTest(expiry=expiry, recurrence=recurrence):
+                t = Task()
+                t.config("gc", "0")
+                t.config("expiry", expiry)
+                t.config("recurrence.trigger", recurrence)
+                t("add expired until:2000-01-01")
+                t("add survivor")
+                t("add recurring due:tomorrow recur:daily")
+                t("count")
+                tasks = t.export("rc.expiry=0 rc.recurrence.trigger=0")
+                expired = next(t for t in tasks if t["description"] == "expired")
+                survivor = next(t for t in tasks if t["description"] == "survivor")
+                self.assertEqual(
+                    expired["status"], "deleted" if expiry == "1" else "pending"
+                )
+                self.assertEqual(survivor["id"], 2)
+                self.assertEqual(
+                    sum("parent" in task for task in tasks), int(recurrence)
+                )
+
+    def test_maintenance_overrides(self):
+        """Blank command-line overrides inherit the effective GC setting"""
+        self.t.config("gc", "0")
+        self.t.config("expiry", "0")
+        self.t.config("recurrence.trigger", "0")
+        self.t("1 modify until:2000-01-01")
+        self.t("add recurring due:tomorrow recur:daily")
+        self.t("rc.gc=1 rc.expiry= rc.recurrence.trigger= count")
+        tasks = self.t.export("rc.expiry=0 rc.recurrence.trigger=0")
+        self.assertEqual(
+            next(t for t in tasks if t["description"] == "one")["status"], "deleted"
+        )
+        self.assertEqual(sum("parent" in task for task in tasks), 1)
+
+    def test_maintenance_boolean_overrides(self):
+        """Command-line booleans independently control maintenance"""
+        self.t.config("expiry", "1")
+        self.t.config("recurrence.trigger", "1")
+        self.t("1 modify until:2000-01-01")
+        self.t("add recurring due:tomorrow recur:daily")
+        self.t("rc.expiry=0 rc.recurrence.trigger=0 count")
+        tasks = self.t.export("rc.gc=0 rc.expiry=0 rc.recurrence.trigger=0")
+        self.assertEqual(
+            next(t for t in tasks if t["description"] == "one")["status"], "pending"
+        )
+        self.assertFalse(any("parent" in task for task in tasks))
+        self.t("rc.gc=0 rc.expiry=1 rc.recurrence.trigger=1 count")
+        tasks = self.t.export("rc.gc=0 rc.expiry=0 rc.recurrence.trigger=0")
+        self.assertEqual(
+            next(t for t in tasks if t["description"] == "one")["status"], "deleted"
+        )
+        self.assertEqual(sum("parent" in task for task in tasks), 1)
+
     def test_gc_on_id(self):
         """IDs reshuffle after report when GC on"""
         self.t.config("gc", "1")
diff --git a/test/read-only.test.py b/test/read-only.test.py
index 858274ffe..8277cd226 100755
--- a/test/read-only.test.py
+++ b/test/read-only.test.py
@@ -90,6 +90,34 @@ class TestReadOnly(TestCase):
         code, out, err = self.t("burndown")
         self.assertNotModified()
 
+    def test_maintenance_disabled(self):
+        """Blank or false maintenance options preserve read-only reports"""
+        self.t.config("gc", "0")
+        for value in ("", "0"):
+            with self.subTest(value=value):
+                self.t.config("expiry", value)
+                self.t.config("recurrence.trigger", value)
+                self.resetTimestamp()
+                self.t("list")
+                self.assertNotModified()
+
+    def test_no_updates_for_read_only_command(self):
+        """Commands without maintenance stay read-only with triggers enabled"""
+        self.t.config("gc", "0")
+        self.t.config("expiry", "1")
+        self.t.config("recurrence.trigger", "1")
+        self.t("add expired until:2000-01-01")
+        self.t("add recurring due:tomorrow recur:daily")
+        self.resetTimestamp()
+        self.t("reports")
+        self.assertNotModified()
+        tasks = self.t.export("rc.expiry=0 rc.recurrence.trigger=0")
+        self.assertEqual(
+            next(t for t in tasks if t["description"] == "expired")["status"],
+            "pending",
+        )
+        self.assertFalse(any("parent" in task for task in tasks))
+
 
