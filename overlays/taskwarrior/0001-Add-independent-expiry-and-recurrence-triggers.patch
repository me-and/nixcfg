+    def test_trigger_respects_master_switch(self):
+        """An explicit recurrence trigger cannot override recurrence=0"""
+        self.t.config("gc", "0")
+        self.t.config("recurrence", "0")
+        self.t.config("recurrence.trigger", "1")
+        self.t("add due:tomorrow recur:daily recurring")
+        self.t("count")
+        tasks = self.t.export()
+        self.assertEqual(len(tasks), 1)
+        self.assertEqual(tasks[0]["status"], "recurring")
+
+    def test_trigger_controls_template_retirement(self):
+        """Template retirement follows the recurrence trigger, not expiry"""
+        self.t.config("gc", "0")
+        self.t.config("recurrence.trigger", "0")
+        self.t.config("expiry", "1")
+        self.t("add due:2000-01-02 until:2000-01-01 recur:daily exhausted")
+        self.t("rc.expiry=0 rc.recurrence.trigger=1 count")
+        self.t("2 done")
+        self.t("count")
+        parent = self.t.export_one("status:recurring")
+        self.t("rc.expiry=0 rc.recurrence.trigger=1 count")
+        self.assertEqual(self.t.export_one(parent["uuid"])["status"], "deleted")
+
 
