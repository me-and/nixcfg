diff --git a/doc/man/taskrc.5.in b/doc/man/taskrc.5.in
index afe84da06..c91383cca 100644
--- a/doc/man/taskrc.5.in
+++ b/doc/man/taskrc.5.in
@@ -216,10 +216,26 @@ Can be used to temporarily suspend rebuilding, so that task IDs don't change.
 Rebuilding requires read/write access to the database, so disabling `gc` may
 result in better performance.
 
+By default, this also controls automatic task expiry and recurrence processing,
+so any commands run with "gc=0" will open the database in read-only mode if
+possible.  The "expiry" and "recurrence.trigger" settings can override that
+behavior independently. Enabling either requires write access to the task
+database for commands that perform that processing, even with gc=0.
+
 Note that this should be used in the form of a command line override (task
 rc.gc=0 ...), and not permanently used in the .taskrc file, as this
 significantly affects performance in the long term.
 
+.TP
+.B expiry=
+Controls whether pending tasks are marked deleted once their 'until' date has
+passed. If unset or blank, this follows the effective 'gc' setting.  Defaults
+to blank.
+
+This only affects commands that normally process expiry, such as reports.  It
+does not change task ID renumbering or recurring template retirement.  Use
+"gc=0" with "expiry=1" to expire tasks without renumbering remaining tasks.
+
 .TP
 .B purge.on-sync=0
 If set, old tasks will be purged automatically after each synchronization.
@@ -499,6 +515,19 @@ If you are syncing multiple clients, then it is advised that you set 'recurrence
 on your primary client, and 'recurrence=0' on ALL other clients. This is a workaround
 for a duplication bug.
 
+.TP
+.B recurrence.trigger=
+Controls automatic recurrence processing: creating recurring task instances
+and marking exhausted recurring templates deleted. If unset or blank, this
+follows the effective 'gc' setting.  Defaults to blank.
+
+For backwards-compatibility reasons, this option will only have any effect if
+"recurrence=1".
+
+This only affects commands that normally process recurring tasks, such as
+reports.  Use gc=0 with recurrence.trigger=1 to process recurrence without
+renumbering existing tasks.
+
 .TP
 .B recurrence.confirmation=prompt
 Controls whether changes to recurring tasks propagates to other child tasks with
diff --git a/src/Context.cpp b/src/Context.cpp
index d04624d51..9c35b20cc 100644
--- a/src/Context.cpp
+++ b/src/Context.cpp
@@ -89,6 +89,7 @@ std::string configurationDefaults =
     "data.location=~/.task\n"
     "gc=1                                           # Garbage-collect data files - DO NOT CHANGE "
     "unless you are sure\n"
+    "expiry=                                        # Expire tasks; blank follows gc\n"
     "exit.on.missing.db=0                           # Whether to exit if ~/.task is not found\n"
     "hooks=1                                        # Master control switch for hooks\n"
     "\n"
@@ -111,6 +112,7 @@ std::string configurationDefaults =
     "override,recur\n"
     "confirmation=1                                 # Confirmation on delete, big changes\n"
     "recurrence=1                                   # Enable recurrence\n"
+    "recurrence.trigger=                            # Process recurrence; blank follows gc\n"
     "recurrence.confirmation=prompt                 # Confirmation for propagating changes among "
     "recurring tasks (yes/no/prompt)\n"
     "allow.empty.filter=1                           # An empty filter gets a warning and requires "
@@ -635,10 +637,11 @@ int Context::initialize(int argc, const char** argv) {
     bool create_if_missing = !config.getBoolean("exit.on.missing.db");
     Command* c = commands[cli2.getCommand()];
 
-    // We must allow writes if either 'gc' is enabled and the command performs GC, or the command
-    // itself is read-write.
-    bool read_write =
-        (config.getBoolean("gc") && (c->needs_gc() || c->needs_recur_update())) || !c->read_only();
+    // Automatic maintenance may require writes even when GC is disabled.
+    bool read_write = (config.getBoolean("gc") && c->needs_gc()) ||
+                      (c->needs_recur_update() && (maintenanceEnabled("expiry") ||
+                                                   maintenanceEnabled("recurrence.trigger"))) ||
+                      !c->read_only();
     tdb2.open_replica(data_dir, create_if_missing, read_write);
 
     ////////////////////////////////////////////////////////////////////////////
@@ -807,6 +810,11 @@ int Context::run() {
   return rc;
 }
 
+////////////////////////////////////////////////////////////////////////////////
+bool Context::maintenanceEnabled(const std::string& key) const {
+  return config.get(key).empty() ? config.getBoolean("gc") : config.getBoolean(key);
+}
+
 ////////////////////////////////////////////////////////////////////////////////
 // Dispatch to the command found by the CLI parser.
 int Context::dispatch(std::string& out) {
@@ -836,9 +844,13 @@ int Context::dispatch(std::string& out) {
     if (config.getBoolean("debug") && config.getInteger("debug.parser") == 1)
       debug(cli2.dump("Parse Tree (before command-specifіc processing)"));
 
-    if (c->needs_recur_update() && Context::getContext().config.getBoolean("gc")) {
-      handleUntil();
-      handleRecurrence();
+    if (c->needs_recur_update()) {
+      if (maintenanceEnabled("expiry")) {
+        handleUntil();
+      }
+      if (maintenanceEnabled("recurrence.trigger")) {
+        handleRecurrence();
+      }
     }
 
     return c->execute(out);
